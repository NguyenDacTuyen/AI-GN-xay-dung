(defun bth-ghichu ( / pO pIn pV1 pV2 pV0 pD pT1 pT2 pN0 pN2 pN4 pN6 pCat pLot pDL pDa os)
  (setvar "CTAB" "Model") (setq os (getvar "OSMODE")) (setvar "OSMODE" 0) (setvar "CMDECHO" 0)
  (TX "8.TP_Text Title" "07.TP_1-50 Title" 175.0 8600.0 5050.0 "GHI CH\\U+00DA:" "L")
  (TX "6.TP_Tex tNote" "08.TP_1-50 Note" 125.0 8600.0 4750.0 "1. K\\U+00EDch th\\U+01B0\\U+1EDBc ghi b\\U+1EB1ng mm, cao \\U+0111\\U+1ED9 ghi b\\U+1EB1ng m. Cao \\U+0111\\U+1ED9 \\U+00B10.000 l\\U+00E0 m\\U+1EB7t s\\U+00E2n ho\\U+00E0n thi\\U+1EC7n (m\\U+1EB7t n\\U+1EAFp b\\U+1EC3)." "L")
  (TX "6.TP_Tex tNote" "08.TP_1-50 Note" 125.0 8600.0 4450.0 "2. Dung t\\U+00EDch h\\U+1EEFu \\U+00EDch V = (2,0 + 1,0 + 1,0) x 1,7 x 1,5 = 10,2 m\\U+00B3." "L")
  (TX "6.TP_Tex tNote" "08.TP_1-50 Note" 125.0 8600.0 4150.0 "3. B\\U+00EA t\\U+00F4ng b\\U+1EC3 B20 (M250) \\U+0111\\U+00E1 1x2; b\\U+00EA t\\U+00F4ng l\\U+00F3t B7,5 (M100) d\\U+00E0y 100." "L")
  (TX "6.TP_Tex tNote" "08.TP_1-50 Note" 125.0 8600.0 3850.0 "4. C\\U+1ED1t th\\U+00E9p \\U+00D8 \\U+2265 10 d\\U+00F9ng CB300-V; \\U+00D8 < 10 d\\U+00F9ng CB240-T. L\\U+1EDBp b\\U+1EA3o v\\U+1EC7: \\U+0111\\U+00E1y 40, th\\U+00E0nh 35, n\\U+1EAFp 25." "L")
  (TX "6.TP_Tex tNote" "08.TP_1-50 Note" 125.0 8600.0 3550.0 "5. X\\U+1EED l\\U+00FD n\\U+1EC1n: c\\U+1EEB tr\\U+00E0m L = 4,5 m, \\U+00D8 g\\U+1ED1c \\U+2265 8-10 cm, m\\U+1EADt \\U+0111\\U+1ED9 25 c\\U+00E2y/m\\U+00B2; c\\U+00E1t \\U+0111\\U+1EC7m d\\U+00E0y 200 \\U+0111\\U+1EA7m ch\\U+1EB7t." "L")
  (TX "6.TP_Tex tNote" "08.TP_1-50 Note" 125.0 8600.0 3250.0 "6. Ch\\U+1ED1ng th\\U+1EA5m: trong l\\U+00F2ng tr\\U+00E1t 2 l\\U+1EDBp v\\U+1EEFa XM M100 d\\U+00E0y 20 c\\U+00F3 ph\\U+1EE5 gia ch\\U+1ED1ng th\\U+1EA5m, \\U+0111\\U+00E1nh m\\U+00E0u;" "L")
  (TX "6.TP_Tex tNote" "08.TP_1-50 Note" 125.0 8600.0 2950.0 "    m\\U+1EB7t ngo\\U+00E0i qu\\U+00E9t bitum ch\\U+1ED1ng th\\U+1EA5m 2 l\\U+1EDBp." "L")
  (TX "6.TP_Tex tNote" "08.TP_1-50 Note" 125.0 8600.0 2650.0 "7. \\U+1ED0ng v\\U+00E0o, \\U+1ED1ng ra, l\\U+1ED7 th\\U+00F4ng qua v\\U+00E1ch: uPVC D114; \\U+1ED1ng th\\U+00F4ng h\\U+01A1i uPVC D60 cao h\\U+01A1n m\\U+1EB7t s\\U+00E2n 700." "L")
  (TX "6.TP_Tex tNote" "08.TP_1-50 Note" 125.0 8600.0 2350.0 "8. \\U+0110\\U+00E1y m\\U+1EDF r\\U+1ED9ng 200 m\\U+1ED7i b\\U+00EAn \\U+0111\\U+1EC3 ch\\U+1ED1ng \\U+0111\\U+1EA9y n\\U+1ED5i. Thi c\\U+00F4ng h\\U+1ED1 \\U+0111\\U+00E0o c\\U+00F3 b\\U+01A1m h\\U+1EA1 m\\U+1EF1c n\\U+01B0\\U+1EDBc ng\\U+1EA7m;" "L")
  (TX "6.TP_Tex tNote" "08.TP_1-50 Note" 125.0 8600.0 2050.0 "    kh\\U+00F4ng h\\U+00FAt c\\U+1EA1n b\\U+1EC3 khi m\\U+1EF1c n\\U+01B0\\U+1EDBc ng\\U+1EA7m cao." "L")
  (TX "6.TP_Tex tNote" "08.TP_1-50 Note" 125.0 8600.0 1750.0 "9. Ng\\U+0103n l\\U+1ECDc: \\U+0111an BTCT d\\U+00E0y 80 \\U+0111\\U+1EE5c l\\U+1ED7 D30 a100, tr\\U+00EAn r\\U+1EA3i \\U+0111\\U+00E1 1x2 d\\U+00E0y 300." "L")
  (TX "6.TP_Tex tNote" "08.TP_1-50 Note" 125.0 8600.0 1450.0 "10. Th\\U+00E9p trong b\\U+1EA3ng th\\U+1ED1ng k\\U+00EA ch\\U+01B0a tr\\U+1EEB ph\\U+1EA7n c\\U+1EAFt t\\U+1EA1i l\\U+1ED7 th\\U+0103m." "L")
  (TX "6.TP_Tex tNote" "08.TP_1-50 Note" 125.0 8600.0 1150.0 "11. K\\U+00EDch th\\U+01B0\\U+1EDBc, c\\U+1ED1t th\\U+00E9p l\\U+00E0 \\U+0111\\U+1EC1 xu\\U+1EA5t theo c\\U+1EA5u t\\U+1EA1o; k\\U+1EF9 s\\U+01B0 thi\\U+1EBFt k\\U+1EBF ki\\U+1EC3m tra tr\\U+01B0\\U+1EDBc khi ph\\U+00E1t h\\U+00E0nh." "L")
  (setvar "OSMODE" os)
  "bth-ghichu OK")
(defun c:BTH10 () (foreach f (list bth-matbang bth-matbangnap bth-matcat-a bth-matcat-b bth-kichthuoc bth-bang bth-ghichu) (f)) (princ))
